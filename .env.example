# Copiá este archivo a .env.local y completá los valores.

# Contraseña del panel /admin (mínimo 6 caracteres).
ADMIN_PASSWORD=cambiar-esta-contrasena

# --- Solo para producción (Vercel): guardar cambios en GitHub ---
# Token fine-grained de GitHub con permiso "Contents: Read and write"
# sobre este único repo. Crearlo en:
# https://github.com/settings/personal-access-tokens/new
# GITHUB_TOKEN=github_pat_xxxx
# GITHUB_REPO=EzequielGonz/AutosMix
# GITHUB_BRANCH=main

# --- Andreani (cotización de envío en el carrito + seguimiento) ---
# Datos que te da tu ejecutivo de cuenta de Andreani. Sin CLIENTE/CONTRATO
# el carrito muestra "envío a coordinar".
# ANDREANI_CLIENTE=CL0001234
# ANDREANI_CONTRATO=400001234            # envío a domicilio
# ANDREANI_CONTRATO_SUCURSAL=400001235   # (opcional) envío a sucursal
# ANDREANI_SUCURSAL_ORIGEN=              # (opcional) sucursal de despacho
# Usuario/contraseña de la API (para la página /seguimiento). Sin estos,
# /seguimiento redirige a andreani.com.
# ANDREANI_USER=
# ANDREANI_PASSWORD=
# ANDREANI_QA=1                          # (opcional) entorno de pruebas
